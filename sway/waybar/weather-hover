#!/usr/bin/env bash

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/weather-location"

if [[ ! -f "$STATE_FILE" ]]; then
    echo 0 > "$STATE_FILE"
fi

INDEX=$(<"$STATE_FILE")

# Make sure the index is valid
if (( INDEX < 0 || INDEX >= ${#LOCATIONS[@]} )); then
    INDEX=0
    echo "$INDEX" > "$STATE_FILE"
fi

LOCATION="${LOCATIONS[$INDEX]}"

curl -fsS --max-time 10 "https://wttr.in/${LOCATION}" 2>/dev/null || echo "Weather unavailable"

