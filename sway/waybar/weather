#!/usr/bin/env bash

# curl -s 'wttr.in/Christchurch/?format=4'
LOCATIONS=(
"Christchurch"
"Queenstown"
"Wellington"
"Auckland"
"Hamilton"
)

STATE_FILE="${XDG_RUNTIME_DIR:-/tmp}/weather-location"

# Create state file if it doesn't exist
if [[ ! -f "$STATE_FILE" ]]; then
    echo 0 > "$STATE_FILE"
fi

INDEX=$(<"$STATE_FILE")

# Make sure the index is valid
if (( INDEX < 0 || INDEX >= ${#LOCATIONS[@]} )); then
    INDEX=0
    echo "$INDEX" > "$STATE_FILE"
fi

LOCATION="${LOCATIONS[$INDEX]}"

# Fetch and display weather
curl -fsS --max-time 10 \
    "https://wttr.in/${LOCATION}?format=4" \
    2>/dev/null || echo "Weather unavailable"
